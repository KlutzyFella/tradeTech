# Copy to apps/server/.env for local development. Production: see docs/runbook.md.
DATABASE_URL=postgresql://tradetech:tradetech@localhost:5432/tradetech
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Exact origin teams open (production: https://your-domain).
WEB_ORIGIN=http://localhost:5173
# true only behind a trusted reverse proxy (Railway, Fly).
TRUST_PROXY=false

# Scale knobs (defaults shown) — see docs/runbook.md
# DATABASE_POOL_MAX=10
# MARKET_SIGNAL_THROTTLE_MS=500
# TICK_INTERVAL_MS=1000
# LOGIN_RATE_LIMIT_MAX=10
# PREVIEW_RATE_LIMIT_PER_SEC=10
# REDIS_URL=redis://...   # required with more than one instance
# WEB_DIST_DIR=           # set by the production image
